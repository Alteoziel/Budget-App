# Auth for /v1 routes (required). Health stays public.
BUDGET_API_KEY=change-me-to-a-long-random-string
# Optional comma-separated alternate keys
# BUDGET_API_KEYS=

APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Sliding-window rate limit per authenticated key (requests / minute)
BUDGET_RATE_LIMIT_PER_MINUTE=60
# BUDGET_RATE_LIMIT_DISABLED=true

# Max request body size in bytes (default 2 MiB)
# BUDGET_MAX_BODY_BYTES=2097152

# Enable FastAPI /docs only when explicitly needed
# BUDGET_ENABLE_DOCS=true
