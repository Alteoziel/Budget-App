# Required Doppler secrets for Alte' Budgeting (web/)
# Create these keys in Doppler → Project `alte-budgeting` → configs: dev / preview / prd
#
#   doppler secrets set NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
#   doppler secrets set NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
#
# Optional (server-only; never expose to the browser):
#   doppler secrets set SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
